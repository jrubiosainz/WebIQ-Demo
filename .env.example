# Copia este fichero a .env y añade tu clave de Web IQ (portal: https://webiq.microsoft.ai/profiles).
# .env está en .gitignore: la clave no se sube al repositorio y nunca llega al navegador.
WEBIQ_API_KEY=

# Caso 0 · modelo que planifica las búsquedas y redacta la respuesta (endpoint compatible con OpenAI v1).
# Sin LLM_API_KEY se usa Entra ID: tu sesión de Azure CLI en local o la identidad administrada en Azure.
# LLM_ENDPOINT=https://<recurso>.cognitiveservices.azure.com/openai/v1
# LLM_MODEL=gpt-5.4-mini
# LLM_API_KEY=

# Caso 0 · protección al publicar la demo
# LIVE_ACCESS_CODE=elige-un-codigo
# TRUST_PROXY=1            # detrás de App Service u otro proxy (IP del visitante en X-Forwarded-For)
# LIVE_PER_MINUTE=6
# LIVE_DAILY_LIMIT=200
# LIVE_MAX_CONCURRENT=4

# Web IQ con Entra ID en lugar de clave (identidad administrada vinculada en el portal o aplicación propia)
# WEBIQ_AUTH=entra
# WEBIQ_APPID=
# WEBIQ_TENANT_ID=
# WEBIQ_CLIENT_ID=
# WEBIQ_CLIENT_SECRET=

# Opcional
# WEBIQ_BASE_URL=https://api.microsoft.ai/v3
# PORT=8787
# HOST=127.0.0.1
# Nombres de host extra para abrir la demo desde otro equipo (además de localhost y las IP):
# WEBIQ_ALLOWED_HOSTS=mi-portatil.local
